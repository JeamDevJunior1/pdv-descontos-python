historico_compras = []

print("Digite 0 no valor da compra para encerrar.\n")

while True:
    valor_bruto = float(input("Digite o valor da compra (R$): "))

    if valor_bruto == 0:
        break

    if valor_bruto < 0:
        print("Aviso: o valor não pode ser negativo. Tente novamente.\n")
        continue

    idade = int(input("Digite a idade do cliente: "))

    if idade < 0:
        print("Aviso: a idade não pode ser negativa. Tente novamente.\n")
        continue

    # Regra 1: desconto por idade
    valor_final = valor_bruto
    if idade >= 65:
        valor_final = round(valor_final * 0.80, 2)

    # Regra 2: desconto por valor
    if valor_final > 100:
        valor_final = round(valor_final * 0.90, 2)

    desconto = round(valor_bruto - valor_final, 2)

    print(f"Valor final desta compra: R$ {valor_final:.2f}\n")

    historico_compras.append({
        "bruto": valor_bruto,
        "desconto": desconto,
        "final": valor_final
    })

# Resumo do dia
print("\n=== RESUMO DO DIA ===")

if len(historico_compras) > 0:
    total_bruto = sum(c["bruto"] for c in historico_compras)
    total_descontos = sum(c["desconto"] for c in historico_compras)
    total_final = sum(c["final"] for c in historico_compras)

    print(f"Quantidade de compras registradas: {len(historico_compras)}")
    print(f"Total bruto: R$ {total_bruto:.2f}")
    print(f"Total de descontos concedidos: R$ {total_descontos:.2f}")
    print(f"Total final: R$ {total_final:.2f}")
else:
    print("Nenhuma compra foi registrada hoje.")
